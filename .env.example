SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct  # PDF语料A/B后运行时默认72B：7B对中文问英文表格上下文会复读乱码（成本更高，见 docs/reports/pdf-ingest-v1-report.md §5）
HF_ENDPOINT=https://hf-mirror.com
MILVUS_URI=http://localhost:19530
EMBED_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Langfuse 可观测（可选）：注册 cloud.langfuse.com 免费版获取；缺省自动降级本地 JSONL（data/traces/）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# RAGAS judge 后端可切换（scripts/run_ragas.py --judge deepseek/siliconflow）；DeepSeek 为
# OpenAI 兼容端点，模型名用户自设（代码不设默认，缺 DEEPSEEK_MODEL 会报错指路）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# T13 API 审批工作流：approve 共享密钥门（可选但非回环部署必配）。配置后
# POST /approvals/{id}/approve 必须携头 X-Approve-Secret=<值>（缺头/不匹配 403）；
# 留空则 approve 端点无鉴权（服务启动日志会警告）。生成：python -c "import secrets; print(secrets.token_urlsafe(24))"
APPROVE_SECRET=
